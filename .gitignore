# Downloaded source datasets, the built site data and the assembled site.
# Regenerate with `make dist` (tools/fetch_data.sh downloads ~190 MB into sources/,
# tools/build_data.py writes site/data/, tools/render.mjs writes site/downloads/,
# dist/ is a copy of site/).
/sources/
/site/data/
/site/downloads/
/dist/

# Leftovers of the 2021 California-only pipeline (kept locally, no longer used)
/geotifs/
/env/
*.kml
*.tif
*.npy
/california_dem.py
/ca_pleasures.svg

# Python / node / editor leftovers
__pycache__/
*.pyc
.venv/
node_modules/
.DS_Store
*.part
*.bak
*.log
